# 복사해서 .env.local 로 쓰세요. .env.local 은 커밋하지 않습니다.
# VITE_ 로 시작하는 값은 브라우저에 그대로 보이므로 비밀 키를 넣지 마세요.

# 로컬 백엔드 주소 (개발 서버 프록시 대상)
VITE_DEV_API_TARGET=http://localhost:8000

# 카카오 로그인 (REST API 키는 공개돼도 되는 값, 비밀 키는 백엔드에만)
VITE_KAKAO_CLIENT_ID=
VITE_KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback

# true면 백엔드 없이 가짜 데이터로 화면을 띄웁니다 (로그인 건너뜀)
VITE_USE_MOCK=true
