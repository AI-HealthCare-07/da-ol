# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=db
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=Password1234@
DB_NAME=ai_health

# redis
REDIS_PORT=6379

# clova ocr (6장 처방 등록). 콘솔 Domain > API Gateway 연동의 Invoke URL과 Secret Key
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# kakao login (명세 4-1). 카카오 개발자 콘솔 [플랫폼 키] > REST API 키, 클라이언트 시크릿
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://daol.site/auth/kakao/callback
