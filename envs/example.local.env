# docker
DOCKER_USER=ozcodingschool
DOCKER_REPOSITORY=ai-health

# fastapi
APP_VERSION=v1.0.0
SECRET_KEY=oz-codingschool-AI-health260127!@
COOKIE_DOMAIN=localhost

# ai-worker
AI_WORKER_VERSION=v1.0.0

# db
DB_HOST=localhost
DB_PORT=5432
DB_EXPOSE_PORT=5432
DB_USER=ozcoding
DB_PASSWORD=pw1234
DB_NAME=ai_health

# clova ocr (6장 처방 등록). 콘솔 Domain > API Gateway 연동의 Invoke URL과 Secret Key
CLOVA_OCR_URL=
CLOVA_OCR_SECRET=

# LLM·임베딩 (7장 가이드·챗봇). 팀에서 받은 키를 .env에만 넣고 커밋하지 않음
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 공공데이터포털 (drugs 데이터 받기). 마이페이지 일반 인증키(Decoding)
DATA_GO_KR_SERVICE_KEY=

# kakao login (명세 4-1). 카카오 개발자 콘솔 [플랫폼 키] > REST API 키, 클라이언트 시크릿
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/auth/kakao/callback
